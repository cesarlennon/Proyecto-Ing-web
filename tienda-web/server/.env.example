# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a Git.

NODE_ENV=development
PORT=3000

# URL con la que se accede al sitio (sin diagonal final). Debe coincidir con las
# URI de redirección registradas en Google Cloud.
URL_BASE=http://localhost:3000

# Base de datos MySQL (usuario con permisos SELECT, INSERT, UPDATE y DELETE)
DB_HOST=localhost
DB_PUERTO=3306
DB_USUARIO=tienda_app
DB_CONTRASENA=
DB_NOMBRE=tienda_web

# Sesiones: cadena aleatoria de al menos 32 caracteres.
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESION_SECRETO=
SESION_MINUTOS=30

# Credenciales OAuth 2.0 de Google (ID de cliente de tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para cifrar el número de tarjeta (AES-256-GCM): 64 caracteres hexadecimales (32 bytes).
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIFRADO_CLAVE=
